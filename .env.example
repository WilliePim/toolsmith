# Copy this file to .env and fill in the values. Never commit .env.

# Which model provider the agent uses: gemini (default) or claude.
PROVIDER=gemini

# Gemini: free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default Gemini model.
GEMINI_MODEL=

# Claude: API key from https://console.anthropic.com (billed per use,
# separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=
# Optional: override the default Claude model (claude-opus-5).
CLAUDE_MODEL=
