{
  "name": "iso_week_label",
  "description": "returns ISO week label for a given date in YYYY-MM-DD format",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "a date as YYYY-MM-DD"
      }
    }
  },
  "set": "core",
  "family": "isoweek",
  "joiner": ",",
  "tests": [
