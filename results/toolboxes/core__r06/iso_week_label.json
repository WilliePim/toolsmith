{
  "name": "iso_week_label",
  "description": "Return the ISO week label for a given date YYYY-MM-DD",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "a date as YYYY-MM-DD"
      }
    }
  },
  "set": "core",
  "family": "isoweek",
  "joiner": ",",
  "tests": [
    {
      "args": {
        "date": "2025-03-17"
