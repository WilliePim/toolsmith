{
  "name": "iso_week_label",
  "description": "Returns the ISO week label YYYY-Www-D for a given date YYYY-MM-DD",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "a date as YYYY-MM-DD"
      }
    }
  },
  "set": "core",
  "family": "isoweek",
  "joiner": ",",
  "tests": [
    {
      "args": {
        "date": "2025-03-17"
      },
      "expect": "2025-W12-1"
    },
    {
      "expect": "2024-W27-4",
      "args": {
        "date": "2024-07-04"
      }
    }
  ],
  "created": "2026-09-19T17:55:09+00:00",
