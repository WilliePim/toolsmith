{
  "name": "iso_week_label",
  "description": "Calculate ISO week label (YYYY-Www-D) for a given date YYYY-MM-DD",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "a date as YYYY-MM-DD"
      }
    }
  },
  "set": "core",
  "family": "isoweek",
  "joiner": ",",
  "tests": [
    {
      "expect": "2025-W12-1",
