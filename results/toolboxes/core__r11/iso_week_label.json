{
  "name": "iso_week_label",
  "description": "convert a YYYY-MM-DD date to an ISO week label YYYY-Www-D",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date"
    ],
    "properties": {
      "date": {
        "type": "string",
        "description": "a date as YYYY-MM-DD"
      }
    }
  },
  "set": "core",
  "family": "isoweek",
  "joiner": ",",
  "tests": [
    {
      "args": {
        "date": "2025-03-17"
      },
      "expect": "2025-W12-1"
    },
    {
      "args": {
        "date": "2024-07-04"
      },
      "expect": "2024-W27-4"
    }
  ],
