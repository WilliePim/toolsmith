{
  "name": "nth_trading_session",
  "description": "Returns the nth trading session strictly after start date given closures",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "start",
      "n",
      "closures"
    ],
    "properties": {
      "start": {
        "type": "string",
        "description": "the start date, YYYY-MM-DD"
      },
      "n": {
        "type": "integer",
        "description": "which session after the start"
      },
      "closures": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "the market holidays, each YYYY-MM-DD"
      }
    }
  },
  "set": "finance",
  "family": "sessions",
  "joiner": ",",
  "tests": [
    {
      "expect": "2025-03-12",
      "args": {
        "closures": [
          "2025-01-01",
          "2025-01-09",
          "2025-01-20",
          "2025-02-17",
          "2025-04-18",
          "2025-05-26",
          "2025-06-19",
          "2025-07-04",
          "2025-09-01",
          "2025-11-27",
          "2025-12-25"
        ],
        "start": "2025-03-07",
        "n": 3
      }
    },
    {
      "expect": "2025-01-02",
      "args": {
        "n": 1,
        "start": "2024-12-31",
        "closures": [
          "2025-01-01"
        ]
      }
    }
  ],
