{
  "name": "trading_session",
  "description": "Find the nth trading session strictly after a start date given holiday closures",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "start",
      "n",
      "closures"
    ],
    "properties": {
      "start": {
        "type": "string",
        "description": "the start date, YYYY-MM-DD"
      },
      "n": {
        "type": "integer",
        "description": "which session after the start"
      },
      "closures": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "the market holidays, each YYYY-MM-DD"
      }
    }
  },
  "set": "finance",
  "family": "sessions",
  "joiner": ",",
  "tests": [
    {
      "args": {
        "n": 3,
        "start": "2025-03-07",
        "closures": [
          "2025-01-01",
          "2025-01-09",
          "2025-01-20",
          "2025-02-17",
          "2025-04-18",
          "2025-05-26",
          "2025-06-19",
          "2025-07-04",
          "2025-09-01",
          "2025-11-27",
          "2025-12-25"
        ]
      },
      "expect": "2025-03-12"
    },
    {
      "expect": "2025-01-02",
      "args": {
        "start": "2024-12-31",
        "n": 1,
        "closures": [
          "2025-01-01"
        ]
      }
    }
  ],
  "created": "2026-09-19T18:20:11+00:00",
  "uses": 12,
  "sha256": "2d5b79ae1175984960e28af6349acd8e1aeffc0a17c9fded07c5d5c3a22ce5a3"
}
